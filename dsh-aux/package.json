{
  "name": "@dolorescaritasangelus/dsh-aux",
  "description": "Auxiliary model system for DSH: unified aux-LLM routing (per-task model, timeout, concurrency, failure cooldown, main-model fallback) plus vision_analyze / web_extract / compress_text tools, settings page, and session status projection",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoloresCaritasAngelus/DSH-AUX.git"
  },
  "bugs": {
    "url": "https://github.com/DoloresCaritasAngelus/DSH-AUX/issues"
  },
  "homepage": "https://github.com/DoloresCaritasAngelus/DSH-AUX#readme",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AI.md",
    "LICENSE",
    "CONTRIBUTIONS.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "auxiliary-model",
    "vision",
    "llm-routing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test ../tests/*.test.js",
    "gen-package-readme": "node ../scripts/gen-package-readme.mjs",
    "prepack": "npm run gen-package-readme"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./route": {
      "types": "./src/route.d.ts",
      "default": "./src/route.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-web": ">=0.1.2-alpha.2 <0.2.0",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    }
  }
}

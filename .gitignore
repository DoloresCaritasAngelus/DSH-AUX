# 依赖与构建产物
node_modules/
*.tgz
*.log
*.tmp

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 敏感配置(防止误提交真实配置)
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# 本机运行时状态(不含附件本体,只防误提交)
.vision-agent.id
tmp-*.mjs

# 维护者专用(过程性内容,不进 GitHub —— 成品仓库只放用户触达的内容)
.local/
# 保留 scripts/ 下的开发脚本但排除构建依赖:gen-package-readme 是 prepack 与
# tests/readme-sync.test.js 的运行依赖,必须随仓库版本走(非过程性残留)。
scripts/*
!scripts/gen-package-readme.mjs
!scripts/doctor.mjs
!scripts/install-dsh-version.mjs
!scripts/ci-fake-dsh.mjs
!scripts/ci-syntax-check.mjs
